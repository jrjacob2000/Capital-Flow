# Environment Variables Reference
# Note: Variables below are commented out in .env.example so AI Studio does not
# repeatedly prompt the Environment Variables popup on every reload.
# Active development variables are already loaded from .env / .env.development,
# and production variables are injected via GitHub Actions Secrets during deploy.

# Production Firebase Configuration (used on GitHub Pages / production builds)
# VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
# VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
# VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
# VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# VITE_FIREBASE_DATABASE_ID="YOUR_FIRESTORE_DATABASE_ID"

# Development Firebase Configuration (used in AI Studio preview & local dev)
# VITE_DEV_FIREBASE_API_KEY="YOUR_DEV_FIREBASE_API_KEY"
# VITE_DEV_FIREBASE_AUTH_DOMAIN="YOUR_DEV_PROJECT_ID.firebaseapp.com"
# VITE_DEV_FIREBASE_PROJECT_ID="YOUR_DEV_PROJECT_ID"
# VITE_DEV_FIREBASE_STORAGE_BUCKET="YOUR_DEV_PROJECT_ID.firebasestorage.app"
# VITE_DEV_FIREBASE_MESSAGING_SENDER_ID="YOUR_DEV_MESSAGING_SENDER_ID"
# VITE_DEV_FIREBASE_APP_ID="YOUR_DEV_FIREBASE_APP_ID"
# VITE_DEV_FIREBASE_DATABASE_ID="YOUR_DEV_FIRESTORE_DATABASE_ID"

